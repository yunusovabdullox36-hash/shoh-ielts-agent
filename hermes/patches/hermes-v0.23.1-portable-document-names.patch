+    def test_telegram_brand_filename_uses_portable_disk_name(self):
+        from gateway.platforms.base import cache_media_bytes
+
+        data = b"<html><p>IELTS</p></html>"
+        result = cache_media_bytes(data, filename="sh|kh - Writing Mock.html", mime_type="text/html")
+        assert result.display_name == "sh|kh - Writing Mock.html"
+        assert Path(result.path).name.endswith("_sh_kh - Writing Mock.html")
+        assert Path(result.path).read_bytes() == data
+
+    def test_windows_path_characters_and_long_unicode_leaf(self):
+        path = Path(cache_document_from_bytes(b"data", "C:\\outside\\a:b?*.html. "))
+        assert path.parent == get_document_cache_dir()
+        assert path.name.endswith("_a_b__.html")
+        long_path = Path(cache_document_from_bytes(b"data", "文" * 200 + ".html"))
+        assert long_path.suffix == ".html"
+        assert len(long_path.name.encode("utf-8")) < 255
+
+    def test_telegram_adapter_caches_large_html_with_pipe_without_inline_text(self):
+        from plugins.platforms.telegram.adapter import TelegramAdapter
+
+        data = b"<html><p>Writing Mock</p></html>" + b" " * 110_000
+        file = SimpleNamespace(download_as_bytearray=AsyncMock(return_value=bytearray(data)))
+        doc = SimpleNamespace(file_name="sh|kh - Writing Mock.html", mime_type="text/html",
+                              file_size=len(data), get_file=AsyncMock(return_value=file))
+        adapter = SimpleNamespace(_max_doc_bytes=20 * 1024 * 1024,
+                                  _surface_media_cache_failure=AsyncMock())
+        event = SimpleNamespace(text="Please read this.")
+        assert not asyncio.run(TelegramAdapter._cache_inbound_document(adapter, SimpleNamespace(document=doc), event))
+        adapter._surface_media_cache_failure.assert_not_called()
+        assert event.media_text_inlined == [False]
+        assert event.text == "Please read this."
+        assert Path(event.media_urls[0]).name.endswith("_sh_kh - Writing Mock.html")
+        assert Path(event.media_urls[0]).read_bytes() == data
+
 
